<?xml version="1.0"?>
<package format="3">
  <name>go2_gazebo</name>
  <version>0.0.1</version>
  <description>Gazebo simulation support for Unitree Go2</description>

  <maintainer email="dein.name@email.com">Dein Name</maintainer>
  <license>Apache-2.0</license>

  <!-- Build type -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies, wenn nötig -->
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
